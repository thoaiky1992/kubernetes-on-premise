# Mẫu Secret cho connector Debezium. Copy thành postgres-cdc-credentials.secret.yaml (đã được .gitignore),
# thay các giá trị <...> bằng credential thật rồi apply. Không commit file thật.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-cdc-credentials
  namespace: kafka
type: Opaque
stringData:
  # Định dạng properties; KafkaConnector đọc từng key bằng ${file:...:key}.
  postgres.properties: |
    database.user=<debezium-user>
    database.password=<password>
